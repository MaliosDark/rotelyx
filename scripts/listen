#!/usr/bin/env bash
#
# A listening test for Telyx, small enough to actually get run.
#
# Every quality figure in this project is signal to noise, and signal to noise
# cannot say whether something sounds right. This can. It plays the same speech
# in eight versions, in a random order, with names that say nothing, and asks
# for a number. The mapping is revealed only at the end.
#
#   scripts/listen              one clip, chosen at random
#   scripts/listen <clip>       a specific clip
#   scripts/listen --reveal     scores so far, with the mapping
#
# The rating scale is the MUSHRA one, and it is printed at the start of every
# session. It used to live only in this comment, where no listener ever saw it:
# the script asked for "a number from 0 to 100" and said nothing about what the
# number meant, so each listener privately decided. One of them rated on whether
# the words were intelligible, which they are at every rate, and scored nothing
# below 87. Two sessions rated against two unstated scales cannot be pooled, and
# the failure was invisible because the numbers still looked like numbers.
#
#
#   100-80  excellent, cannot tell it from the original
#    80-60  good, a difference you have to listen for
#    60-40  fair, clearly different but not annoying
#    40-20  poor, annoying
#    20-0   bad
#
# Two of the eight are there to check the listener rather than the codec. One
# is the untouched original: if it does not score near 100, the session is not
# usable and that is worth knowing before drawing conclusions from the rest.
# The other is the original low-passed at 3.5 kHz, which is what a telephone
# sounds like and gives the bottom of the scale a fixed meaning.

set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/target/listening"

# Who is listening.
#
# One file for everybody pools two people into an average that describes
# neither, and the pooling cannot be undone: the ratings are the only record,
# and a rating with no name on it belongs to nobody. The whole reason to want a
# second listener is to see whether two people agree, so the name is required
# rather than defaulted.
LISTENER="${LISTENER:-}"
if [ "${1:-}" = "--as" ]; then
    LISTENER="${2:-}"
    shift 2
fi
RESULTS="$DIR/ratings-${LISTENER}.txt"

if [ ! -d "$DIR" ]; then
    echo "No files. Build them first:"
    echo "  cargo run --release -p rotelyx-codec --example bake_listening_test"
    exit 1
fi

# Whichever player exists. aplay is ALSA, paplay is PulseAudio, and a machine
# usually has exactly one of them working.
PLAYER=""
for p in paplay aplay ffplay; do
    if command -v "$p" >/dev/null 2>&1; then
        case "$p" in
            ffplay) PLAYER="ffplay -nodisp -autoexit -loglevel quiet" ;;
            *)      PLAYER="$p" ;;
        esac
        break
    fi
done
[ -z "$PLAYER" ] && { echo "No audio player found (tried paplay, aplay, ffplay)."; exit 1; }

# Turn one ratings file into "listener <tab> system <tab> rating" lines.
attribute() {
    awk -v who="$2" 'NR==FNR {
              # The name, then two or more spaces, then a system name that
              # itself contains spaces ("telyx 12 kbit/s"). Splitting on single
              # spaces truncates every system name. Looking for a fixed arrow
              # matched nothing at all, because the baker never wrote one, and
              # the failure was silent: every rating came back "unknown" and the
              # session looked usable. Match the first run of two spaces, which
              # is what is actually in the file.
              if (match($0, /^[A-Za-z0-9_]+  +/)) {
                  name = substr($0, 1, RLENGTH); gsub(/ +$/, "", name)
                  rest = substr($0, RLENGTH + 1); gsub(/^ +| +$/, "", rest)
                  if (rest != "") key[name] = rest
              }
              next
           }
           NF == 2 {
              sys = key[$1]; if (sys == "") sys = "unknown"
              printf "%s\t%s\t%s\n", who, sys, $2
           }' "$DIR/key.txt" "$1"
}

reveal() {
    shopt -s nullglob
    local files=("$DIR"/ratings-*.txt)
    if [ ${#files[@]} -eq 0 ]; then
        echo "No ratings yet."
        exit 0
    fi

    local stream
    stream="$(mktemp)"
    trap 'rm -f "$stream"' EXIT
    local f who
    for f in "${files[@]}"; do
        who="$(basename "$f" .txt)"; who="${who#ratings-}"
        attribute "$f" "$who" >> "$stream"
    done

    awk -F'\t' '
        { sum[$1 SUBSEP $2] += $3; n[$1 SUBSEP $2]++
          list[$1 SUBSEP $2] = list[$1 SUBSEP $2] " " $3
          who[$1] = 1; sys[$2] = 1 }
        END {
            for (w in who) {
                printf "\n  listener: %s\n", w
                printf "  system                     n   mean   ratings\n"
                printf "  ------------------------------------------------------\n"
                for (s in sys)
                    if ((w SUBSEP s) in sum)
                        printf "  %-24s %3d  %5.1f  %s\n", s, n[w SUBSEP s],
                               sum[w SUBSEP s] / n[w SUBSEP s], list[w SUBSEP s]
            }

            listeners = 0
            for (w in who) listeners++
            if (listeners < 2) exit

            # Two people who disagree about one rate by more than the gap
            # between rates are two people whose average describes neither.
            printf "\n  where they disagree\n"
            printf "  ------------------------------------------------------\n"
            for (s in sys) {
                line = ""; seen = 0; lo = 0; hi = 0
                for (w in who) {
                    if (!((w SUBSEP s) in sum)) continue
                    m = sum[w SUBSEP s] / n[w SUBSEP s]
                    line = line sprintf(" %s %.1f", w, m)
                    if (!seen) { lo = m; hi = m; seen = 1 }
                    if (m < lo) lo = m
                    if (m > hi) hi = m
                }
                if (seen) printf "  %-24s spread %5.1f %s\n", s, hi - lo, line
            }
        }' "$stream"

    echo
    echo "  If 'reference (untouched)' is not near 100, the session is not usable."
    exit 0
}

[ "${1:-}" = "--reveal" ] && reveal

if [ -z "$LISTENER" ]; then
    cat <<'EOF'

  Say who is listening:

    scripts/listen --as <name> [clip]

  Ratings are written per listener. Two people writing to one file become an
  average that describes neither, and there is no way to separate them
  afterwards, because the ratings are the only record of who said what.

EOF
    exit 1
fi

# Pick a clip.
mapfile -t CLIPS < <(ls "$DIR"/*.wav 2>/dev/null | xargs -n1 basename | sed 's/_[a-z]\{6\}\.wav$//' | sort -u)
[ ${#CLIPS[@]} -eq 0 ] && { echo "No clips in $DIR"; exit 1; }

if [ -n "${1:-}" ]; then
    CLIP="$1"
else
    CLIP="${CLIPS[$((RANDOM % ${#CLIPS[@]}))]}"
fi

mapfile -t FILES < <(ls "$DIR/${CLIP}"_*.wav 2>/dev/null | shuf)
# Every file offered must be in the key, or the session cannot be read back.
# Refusing here rather than at reveal time: the cost of finding out afterwards
# is somebody's whole listening session, and the first real use of this script
# lost one exactly that way.
ORPHANS=0
for f in "${FILES[@]}"; do
    n="$(basename "$f" .wav)"
    grep -q "^$n  " "$DIR/key.txt" 2>/dev/null || { echo "  not in key.txt: $n"; ORPHANS=1; }
done
if [ "$ORPHANS" != "0" ]; then
    echo
    echo "  Those are left over from an earlier bake. Rebuild before listening:"
    echo "    cargo run --release -p rotelyx-codec --example bake_listening_test"
    exit 1
fi

[ ${#FILES[@]} -eq 0 ] && { echo "No files for '$CLIP'. Available:"; printf '  %s\n' "${CLIPS[@]}"; exit 1; }

echo
echo "  Clip: $CLIP     ${#FILES[@]} versions, random order"
cat <<'EOF'
  Rate how far each one is from the original, not how well you can follow it.
  Speech stays intelligible long after it stops sounding like the speaker, so
  rating on whether you understood the words puts everything near 100 and
  measures nothing.

    100-80  cannot tell it from the original
     80-60  a difference you have to listen for
     60-40  clearly different, but not annoying. "robotic" lives here
     40-20  annoying
      20-0  bad

  Enter replays. 's' skips. 'q' quits and saves.
EOF
echo

for f in "${FILES[@]}"; do
    name="$(basename "$f" .wav)"
    while true; do
        $PLAYER "$f" >/dev/null 2>&1
        printf "  [%s] rating (0-100, enter to replay): " "$name"
        read -r answer </dev/tty
        case "$answer" in
            "")   continue ;;
            s|S)  break ;;
            q|Q)  echo; echo "  Saved to $RESULTS"; echo "  scripts/listen --reveal"; exit 0 ;;
            *)
                if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -le 100 ]; then
                    echo "$name $answer" >> "$RESULTS"
                    break
                fi
                echo "  A number from 0 to 100, or enter to replay." ;;
        esac
    done
done

echo
echo "  Done. Ratings in $RESULTS"
echo "  Run more clips, then: scripts/listen --reveal"
