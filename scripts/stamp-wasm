#!/usr/bin/env bash
# Stamp chat.html with a build id derived from the wasm itself.
#
# Why this exists: CWP serves .js and .wasm with `expires max`, and Cloudflare
# caches that for ten years. Uploading a new build does nothing, because nobody
# ever asks for it again. A stamp in the URL makes each build a different
# resource, so a stale cache cannot serve the old half of a pair that must
# match.
#
# The stamp comes from the wasm's own hash rather than a date, so an unchanged
# build does not needlessly invalidate a cache that is correct.
set -euo pipefail
cd "$(dirname "$0")/.."

STAMP=$(sha256sum site/rotelyx/rotelyx_wasm_bg.wasm | cut -c1-12)

python3 - "$STAMP" <<'PY'
import re, sys
stamp = sys.argv[1]
p = 'site/chat.html'
s = open(p).read()
# The directory is matched rather than named, so this keeps working if the
# engine moves again. It has moved once: `/rotelyx/` is intercepted on the
# production server and unreadable, so the engine lives in `assets/`. A rewrite
# that hardcoded the old directory would have silently undone that move on the
# next build, which is the kind of repair that lasts until somebody runs a
# script.
s, n = re.subn(r"from '\./[a-z]+/rotelyx_wasm\.js(\?v=[0-9a-f]+)?'",
               lambda m: m.group(0).split('?')[0].rstrip("'") + f"?v={stamp}'", s)
if n != 1:
    raise SystemExit(
        f"expected one module import to stamp in {p}, found {n}. "
        "Stamping nothing leaves the page asking for a cached build for ever."
    )
s = re.sub(r"rotelyx_wasm_bg\.wasm(\?v=[0-9a-f]+)?", f"rotelyx_wasm_bg.wasm?v={stamp}", s)
open(p, 'w').write(s)
print(f"  stamped {stamp}")
PY
