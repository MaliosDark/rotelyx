def sitemap() -> str:
    """Every page, so a search engine finds the ones nothing links to prominently."""
    urls = ["index.html", "how-it-works.html", "architecture.html", "paper.html",
            "chat.html"] + [slug for slug, *_ in PAGES]
    body = "\n".join(
        f"  <url><loc>https://rotelyx.com/{u}</loc><lastmod>2026-08-29</lastmod></url>"
        for u in urls
    )
    return ('<?xml version="1.0" encoding="UTF-8"?>\n'
            '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
            f"{body}\n</urlset>\n")


def main() -> int:
    for slug, title, description, eyebrow, h1, body in PAGES:
        (SITE / slug).write_text(page(slug, title, description, eyebrow, h1, body))
        print(f"  {slug}")

    (SITE / "sitemap.xml").write_text(sitemap())
    print("  sitemap.xml")

    robots = SITE / "robots.txt"
    text = robots.read_text() if robots.exists() else "User-agent: *\nAllow: /\n"
    if "Sitemap:" not in text:
        text = text.rstrip() + "\n\nSitemap: https://rotelyx.com/sitemap.xml\n"
        robots.write_text(text)
        print("  robots.txt now names the sitemap")

    print(f"\n{len(PAGES)} pages written. Upload site/ whole: the footer on every")
    print("one of them links to the others, so a half-finished upload leaves")
    print("dead links on the pages that did go up.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
